{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(gh pr*)",
      "Bash(gh auth status)",
      "Bash(npm install)",
      "Bash(npm run*)",
      "Bash(npx*)",
      "Bash(shopify theme dev*)",
      "Bash(shopify theme check*)",
      "Bash(shopify theme pull*)",
      "Bash(shopify theme list*)",
      "Bash(shopify theme info*)",
      "WebFetch(domain:shopify.dev)"
    ],
    "ask": [
      "Bash(shopify theme push*)",
      "Bash(shopify theme publish*)",
      "Bash(shopify theme delete*)"
    ]
  }
}
